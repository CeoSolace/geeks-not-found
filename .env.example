# MongoDB connection URI
MONGO_URI=

# Application base URL
APP_URL=http://localhost:3000

# Secret used to sign JWT tokens and session cookies
AUTH_SECRET=

# Developer emergency control route and key
DEV_CONTROL_ROUTE=
DEV_CONTROL_KEY=

# Optional one-time founder recovery bootstrap.
# Only set these in Render when you need to restore FounderMan2 without DB access.
# Remove or rotate them after recovery succeeds.
FOUNDER_BOOTSTRAP_TOKEN=
FOUNDER_BOOTSTRAP_PASSWORD=
