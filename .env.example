# MongoDB connection URI
# Still used for dashboard data/audits, but NOT for logging in.
MONGO_URI=

# Application base URL
APP_URL=http://localhost:3000

# Secret used to sign JWT tokens and session cookies.
# Optional: if blank, F_PASSWORD is used as the signing secret.
AUTH_SECRET=

# Founder login credentials from env only.
# These replace the old MongoDB login/user system.
F_LOGIN=
F_PASSWORD=

# Developer emergency control route and key
DEV_CONTROL_ROUTE=
DEV_CONTROL_KEY=

# Optional one-time founder recovery bootstrap.
# Old Mongo founder recovery path; not needed for env login.
FOUNDER_BOOTSTRAP_TOKEN=
FOUNDER_BOOTSTRAP_PASSWORD=
